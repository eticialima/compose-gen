generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SavedStack {
  id          String   @id @default(cuid())
  name        String
  backend     String
  database    String
  cache       String?
  adminTools  String[]
  composeYaml String   @db.Text
  envExample  String   @db.Text
  warnings    String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
